<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Remindly" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorOnBackground">@color/on_surface</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_system_bars</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Remindly.Dialog</item>
        <item name="materialCalendarTheme">@style/ThemeOverlay.Remindly.Calendar</item>
        <item name="materialTimePickerTheme">@style/ThemeOverlay.Remindly.TimePicker</item>
    </style>

    <style name="Theme.Remindly.Splash" parent="Theme.Remindly">
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:statusBarColor">@color/splash</item>
        <item name="android:navigationBarColor">@color/splash</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <style name="ThemeOverlay.Remindly.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog" />

    <style name="ThemeOverlay.Remindly.Calendar" parent="ThemeOverlay.Material3.MaterialCalendar" />

    <style name="ThemeOverlay.Remindly.TimePicker" parent="ThemeOverlay.Material3.MaterialTimePicker" />

    <style name="TextAppearance.Remindly.Toolbar" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Remindly.Section" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Widget.Remindly.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="cardBackgroundColor">@color/card</item>
    </style>
</resources>
